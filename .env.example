# The server reads Kite credentials from D:\stock-basket\.env by default on this machine.
# Override with KITE_SOURCE_ENV if needed. Do not put credentials in frontend files.
KITE_SOURCE_ENV=
# Optional direct override for the OI Analyzer token file.
OI_ANALYZER_ENV_PATH=
# Private backend fallback; never include this file in release archives.
EIA_API_KEY=
